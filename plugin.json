{
  "manifestVersion": 2,
  "publisher": "kazeliu",
  "name": "cpr-data-toolkit",
  "displayName": "CPR 数据工具箱",
  "version": "1.1.0",
  "description": "连接与用量导入、统计调整、模型定价、模型UA与上游额度查询",
  "license": "UNLICENSED",
  "engines": { "codex-proxy-rs": ">=3.30.1, <4.0.0" },
  "main": "bin/plugin",
  "runtime": "trustedProcess",
  "configurationSchema": {
    "type": "object",
    "properties": {},
    "additionalProperties": false
  },
  "contributes": {
    "management": { "version": 2 },
    "middleware": {
      "version": 5,
      "stages": ["request"],
      "inputFormats": ["openai"],
      "outputFormats": ["openai"]
    }
  },
  "resources": {
    "web/index.html": "text/html",
    "web/app.js": "text/javascript",
    "web/app.css": "text/css"
  },
  "state": [
    {
      "namespace": "model_ua",
      "schemaVersion": 1,
      "schema": {
        "type": "object",
        "required": ["rules"],
        "additionalProperties": false,
        "properties": {
          "rules": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "required": [
                "id",
                "enabled",
                "keyword",
                "userAgent",
                "originator",
                "version"
              ],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string", "minLength": 1, "maxLength": 128 },
                "enabled": { "type": "boolean" },
                "keyword": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "userAgent": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "originator": { "type": ["string", "null"], "maxLength": 4096 },
                "version": { "type": ["string", "null"], "maxLength": 4096 }
              }
            }
          }
        }
      },
      "maximumRecords": 1,
      "maximumBytes": 131072,
      "maximumValueBytes": 131072,
      "migratesFrom": []
    },
    {
      "namespace": "imports",
      "schemaVersion": 1,
      "schema": {
        "type": "object",
        "required": ["entries"],
        "additionalProperties": false,
        "properties": {
          "entries": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "type": "object",
              "required": [
                "appType",
                "providerId",
                "installationId",
                "accountId",
                "status"
              ],
              "additionalProperties": false,
              "properties": {
                "appType": { "type": "string", "maxLength": 64 },
                "providerId": { "type": "string", "maxLength": 256 },
                "installationId": { "type": "string", "maxLength": 128 },
                "accountId": { "type": ["string", "null"], "maxLength": 256 },
                "status": { "enum": ["pending", "failed", "saved"] }
              }
            }
          }
        }
      },
      "maximumRecords": 1,
      "maximumBytes": 262144,
      "maximumValueBytes": 262144,
      "migratesFrom": []
    },
    {
      "namespace": "usage_adjustment",
      "schemaVersion": 1,
      "schema": {
        "type": "object",
        "required": ["command", "status"],
        "additionalProperties": false,
        "properties": {
          "status": { "enum": ["pending", "saved", "rejected"] },
          "command": {
            "type": "object",
            "required": ["id", "atMs", "tokens", "requests"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "maxLength": 36 },
              "atMs": { "type": "integer" },
              "tokens": { "type": "string", "maxLength": 20 },
              "requests": { "type": "string", "maxLength": 20 }
            }
          }
        }
      },
      "maximumRecords": 1,
      "maximumBytes": 4096,
      "maximumValueBytes": 4096,
      "migratesFrom": []
    }
  ]
}
